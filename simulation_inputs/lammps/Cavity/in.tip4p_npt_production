# -------------------------------
# TIP4P/2005 NpT production run
# -------------------------------

units           real
boundary        p p p
atom_style      full
bond_style      harmonic
angle_style     harmonic

# --- Groups

variable TK equal ${T}

# Read starting structure (built by build.in)
variable read_file string "tip4p_6nm_approx.data"
read_data ${read_file}

group           oxy type 1

# Override bond/angle coefficients to TIP4P/2005 geometry
# SHAKE will constrain to these values
bond_coeff  1 450.0 0.9572
angle_coeff 1  55.0 104.52

# TIP4P/2005 pair style + long-range electrostatics
# M-site distance for TIP4P/2005: 0.1546 Å
pair_style lj/cut/tip4p/long 1 2 1 1 0.1546 12.0
kspace_style pppm/tip4p 1.0e-5

pair_coeff 1 1 0.18521 3.15890   # O-O TIP4P/2005
pair_coeff 1 2 0.0     0.0       # O-H
pair_coeff 2 2 0.0     0.0       # H-H

pair_modify     tail yes
neighbor 3 bin
neigh_modify delay 10 every 1 check yes
newton  on

# SHAKE must come before any box-changing fix
fix shake all shake 0.0001 20 0 b 1 a 1

kspace_modify   collective yes

# Relax geometry with capped step to avoid blowup on first step
min_modify dmax 0.1
minimize 1.0e-4 1.0e-6 1000 1000

# Timestep
timestep 2.0

print "NVT equilibration"
fix 1 all nvt temp ${TK} ${TK} 100.0
thermo 1000
run 13000
unfix 1

print "Starting NPT equilibration T=${T} K, P=${P} atm"
fix 1 all npt temp ${TK} ${TK} 200.0 iso ${P} ${P} 500.0 drag 1.0
thermo_style custom step temp press etotal density lx ly lz
thermo 1000
run 10000

# Write final equilibrated structure
write_data equilibrated1-water.data

# --- Oxygen-only dump every 500 steps
dump            dO oxy custom 500 dump.oxy id type x y z
dump_modify     dO sort id

# --- Optional: trajectory unwrap (if needed)
# dump_modify   dO unwrap yes

# --- Run
unfix 1
fix 1 all npt temp ${TK} ${TK} 200.0 iso ${P} ${P} 2000.0

thermo_style custom step temp press etotal density vol lx ly lz
thermo 1000

run             80000000

# --- Write final config
write_data      tip4p_npt_final.data nocoeff


