# Pmf for spheres in mw
units		real
atom_style	atomic

atom_modify map yes #needed to pick from arrays

variable        solute_rad equal ${solute_diam}*0.5
variable        sol_radplus equal ${solute_rad}+1.2
variable        startRho equal 0.997
variable        alpha equal 3.0
variable        mwMass equal 18.015 #grams/mol
read_data	onlyWater.start

print "sol_radplus=${sol_radplus}"

# get more particles: multiples of 20^3 box.

replicate ${rep} ${rep} ${rep}

# calculate half of the box size in armstrongs for a cubic box
variable        num_atoms equal count(all)
variable        hL     equal  (${num_atoms}/0.602214076*${mwMass}/${startRho})^(1./3.)*0.5
change_box all x final -${hL} ${hL} y final -${hL} ${hL} z final -${hL} ${hL} 
reset_timestep	0

# make room for the solute

region 1 sphere 0.0 0.0 0.0 ${sol_radplus} side in
region 2 sphere  ${solute_diam} 0.0 0.0 ${sol_radplus} side in
delete_atoms region 1 compress yes
delete_atoms region 2 compress yes


#Place two spheres touching in centre
create_atoms 2 single 0 0 0
create_atoms 3 single ${solute_diam} 0 0

# you  need to cut at the right distance, i.e. the radius for a purely repulsive sphere

#pair_style hybrid sw threebody on morse/smooth/linear ${solute_diam}
pair_style hybrid sw threebody on table linear 4000 morse/smooth/linear ${solute_diam}


pair_coeff * * sw mW.sw mW NULL NULL

# --- water-solute now uses tabulated potential ---
pair_coeff 1 2 table Vext${D0water}.table VEXT
pair_coeff 1 3 table Vext${D0water}.table VEXT

# --- solute-solute interactions unchanged ---
pair_coeff 2 2 morse/smooth/linear  1.0 ${alpha} ${solute_rad} ${solute_rad} 
pair_coeff 2 3 morse/smooth/linear  1.0 ${alpha} ${solute_diam} ${solute_diam}
pair_coeff 3 3 morse/smooth/linear  1.0 ${alpha} ${solute_rad} ${solute_rad}


mass		1 ${mwMass}
mass		2 ${mwMass}
mass		3 ${mwMass}

group		mW type 1
group		a2 type 2
group		a3 type 3
group           sols type 2 3

neighbor	2 bin #Angstroms
neigh_modify	every 1 delay 0 check yes

#immobilize both solutes so that they don't drift outside the Plumed upper_wall

fix freeze2 a2 setforce 0.0 0.0 0.0
fix freeze3 a3 setforce 0.0 0.0 0.0

velocity	mW zero linear

set group a2 vx 0.0 vy 0.0 vz 0.0
set group a3 vx 0.0 vy 0.0 vz 0.0


# Do a quick energy minimization to remove overlaps
minimize 1.0e-6 1.0e-8 1000 1000

timestep 2.0

compute myTemp mW temp

fix		1 all nvt temp ${T} ${T} 100
fix_modify 1 temp myTemp

thermo 1000
run             12000
reset_timestep	0
unfix 1

fix		1 all npt temp ${T} ${T} 500 iso ${P} ${P} 500
fix_modify 1 temp myTemp
run             22000
write_data 	equilibrated.water.solute.data
